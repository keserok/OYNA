# ============================================
# OYNA APP - Environment Variables
# Bu dosyayi .env olarak kopyalayip degerleri doldurun
# cp .env.example .env
# ============================================

# Supabase (ZORUNLU)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Edge Function Secrets (supabase secrets set ile ayarlanir)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin panel deploy (npm run admin:deploy) — birini ekleyin:
# SUPABASE_ACCESS_TOKEN=sbp_...        # önerilen — Dashboard → Account → Access Tokens
# SUPABASE_DB_PASSWORD=...             # alternatif — Dashboard → Project Settings → Database

# Apple Push Notification (iOS push icin)
# APNS_KEY_ID=your-key-id
# APNS_TEAM_ID=your-team-id
# APNS_PRIVATE_KEY=your-private-key-pem
# APNS_BUNDLE_ID=com.oyna.app
# APNS_PRODUCTION=false

# Google FCM (Android push icin)
# GOOGLE_PROJECT_ID=your-project-id
# GOOGLE_SERVICE_ACCOUNT_KEY=your-service-account-json

# Opsiyonel — uygulama URL'i (deep link ve paylaşım icin)
# VITE_APP_URL=https://app.oyna.com

# Opsiyonel — ayrık yönetim paneli adresi (uygulamadaki "Paneli Aç" yönlendirmesi
# bunu kullanır; verilmezse oynaturkiyepotansiyeli.com'a düşer). Yalnız ANA uygulama
# build'ine (build:app) gerekir; admin build'i (build:admin) kendini sunar.
# VITE_ADMIN_PANEL_URL=https://oynaturkiyepotansiyeli.com

# Opsiyonel — OwnerPanel demo seed (sadece gelistirme ortami)
# VITE_OWNER_DEMO_AUTO_SEED=true

# Geliştirme modu — yerel .env'de true yap, PRODUCTION'DA ASLA EKLEME
# IS_LOCAL_DEV sabitini kontrol eder: true → mock veri aktif, auth bypass, SPLASH atlanır.
# VITE_DEV_MODE=true

# ============================================
# FAZ 7 — Ödeme · Gözlemlenebilirlik · E-posta
# Hepsi opsiyonel: doldurulmadıkça ilgili özellik SİMÜLASYON/no-op çalışır.
# ============================================

# ── Ödeme sağlayıcısı (iyzico) — Edge Function Secrets ──
# Sözleşme/KYC tamamlanınca PAYMENT_PROVIDER=IYZICO yapılır; öncesi SIMULATION.
# PAYMENT_PROVIDER=SIMULATION
# IYZICO_API_KEY=sandbox_xxx
# IYZICO_SECRET_KEY=sandbox_xxx
# IYZICO_BASE_URL=https://sandbox-api.iyzipay.com    # prod: https://api.iyzipay.com
# IYZICO_CALLBACK_URL=https://<proje>.supabase.co/functions/v1/payment-webhook
# PAYMENT_EDGE_SECRET=<rastgele>   # capture-payment / void-payment sistem çağrısı yetkisi
# ALLOWED_ORIGIN=https://app.oyna.com   # edge function CORS kısıtı (boş = '*'; pre-launch'ta doldurulmalı)

# ── Gözlemlenebilirlik (frontend) — Sentry (hata) + PostHog (analitik) ──
# Boşsa utils/observability.ts tamamen no-op'tur (build her zaman yeşil).
# VITE_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# VITE_SENTRY_SAMPLE=0.1
# VITE_POSTHOG_KEY=phc_xxx
# VITE_POSTHOG_HOST=https://us.i.posthog.com          # AB için: https://eu.i.posthog.com
# VITE_APP_VERSION=oyna@1.0.0                          # Sentry release etiketi

# ── İşlemsel e-posta (Resend) — Edge Function Secrets ──
# RESEND_API_KEY yoksa send-email SİMÜLASYON çalışır (gerçek mail gitmez).
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=OYNA <no-reply@oyna.app>
# EMAIL_EDGE_SECRET=<rastgele>     # send-email sistem çağrısı yetkisi
