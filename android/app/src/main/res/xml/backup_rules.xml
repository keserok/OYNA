<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 (API 30) ve altı için yedekleme kuralları.
  Gerekçe data_extraction_rules.xml ile aynıdır: oturum belirteci (giriş
  anahtarı) hiçbir yedeğe çıkmamalıdır. allowBackup zaten "false" olduğundan
  bu dosya ikinci bir güvenlik katmanıdır.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
