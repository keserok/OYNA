<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- oyna:// özel şema deep link (push dışı URL açılışları) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="oyna" />
            </intent-filter>
        </activity>

        <!--
          Android 16 (API 36) davranış değişikliği: hedef sürüm 36 olan
          uygulamalarda, en dar kenarı 600dp'den geniş ekranlarda (tablet,
          katlanabilir telefonun açık hâli) android:screenOrientation="portrait"
          YOK SAYILIR — yani uygulama yatay dönebilir hâle gelir.

          OYNA'nın arayüzü telefon-dikey tasarlanmıştır; tablette yatay açılması
          bozuk görünüme ve mağaza incelemesinde ret riskine yol açar. Aşağıdaki
          özellik, dikey kilidini Android 16'da da geçerli kılar.

          NOT: Bu bir GEÇİŞ kolaylığıdır; hedef sürüm 37 olduğunda geçerliliğini
          yitirir. Kalıcı çözüm, arayüzün yatay/tablet düzenini gerçekten
          desteklemesidir (lansman sonrası işi).
        -->
        <property android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_ORIENTATION" android:value="true" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Yakındaki saha/maç keşfi (Geolocation) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- QR bilet tarama ve profil fotoğrafı (Camera) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Android 13+ push bildirim izni -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
