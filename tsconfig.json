{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node",
      "vite/client"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "exclude": [
    "node_modules",
    "node_modules_local",
    "node_modules_old",
    "dist",
    "ios",
    "android",
    "public",
    "assets",
    "reports",
    "docs",
    "scripts",
    "design-kit",
    "New Folder",
    "supabase",
    "notifications",
    "src",
    "arsiv",
    "test_browser.cjs",
    "test_compile.js",
    "test_page.ts",
    "test_scanner.js",
    "test_vite_start.js",
    "tests",
    "playwright.config.ts"
  ]
}