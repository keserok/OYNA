# Sondaki eğik çizgi YALNIZ klasörü yok sayar. 2026-08-01'de depoya
# `node_modules` adında bir KISAYOL (symlink) girdi ve bu desen onu tutmadı:
# dalı alan herkeste node_modules kendine dönen bozuk bir bağa dönüştü, tüm
# araçlar kırıldı. Eğik çizgisiz desen ikisini de kapsar.
node_modules
.vite/
dist/
*.zip
*.pdf
.DS_Store
.env
.env.local
.env.*.local
!.env.example
node_modules_old/
node_modules_local/
my_vite.log
tsc_err.log
reports/
scripts/*
!scripts/owner-demo.mjs
!scripts/owner-menu-live-test.mjs
!scripts/regenerate-migrations-from-ledger.mjs
# Mobil paket derlemesi — sync:ios/sync:android bu betiği çağırır. Depoda
# OLMAK ZORUNDA: temiz bir kopyada ya da CI'da yoksa paket hiç üretilemez.
!scripts/build-mobile.mjs
# Kılavuz ekran görüntüsü çekim aracı (tekrar üretilebilirlik için depoda)
!scripts/kilavuz-gorselleri/
!scripts/kilavuz-gorselleri/**
# Mağaza gönderim araçları — depoda OLMAK ZORUNDA. `scripts/*` kalıbı bunları
# sessizce yutuyordu: `npm run magaza:denetim` ve `npm run surum:artir` temiz
# bir kopyada çalışmıyor, gönderim kapısını sınayan testler CI'da ENOENT
# veriyordu. Gönderimin geçtiği kapı, depoda duran bir kapı olmalı.
!scripts/magaza-denetim.mjs
!scripts/surum-artir.mjs
# Mekanizma betikleri (PRENSİPLER §9) — `npm run etki` buradan çalışır.
# İKİ satır ŞART: `scripts/*` dizini yok saydığında git içine inmez,
# tek başına dosya istisnası ölü kalır (kilavuz-gorselleri emsali).
!scripts/sistem/
!scripts/sistem/**
# `vitrin:gorseller` — canlıdaki her saha/kort fotoğrafını tek sayfada basar.
# 25 Ağu 2026'da vitrinde bir FIFA kupası renderı ve çocuk fotoğrafları
# bulundu; ikisi de aylardır oradaydı çünkü bakmak zahmetliydi. Bu betik
# bakmayı on saniyeye indiriyor — depoda olmazsa yine kimse bakmaz.
!scripts/vitrin-gorselleri.mjs
# `magaza:ekran` — App Store'un istediği 1290×2796 ölçüsünde ham ekran
# görüntüsü çeker. Ölçü tutmazsa App Store Connect yüklemeyi reddediyor;
# ölçüyü akılda tutmak yerine betikte tutuyoruz.
!scripts/magaza-ekran-goruntuleri.mjs
# `depo:sil` — herkese açık kovadan işaretli dosyaları kalıcı siler. SQL ile
# yapılamaz (Supabase storage.protect_delete engelliyor); depolama API'si
# gerekiyor. Silme geri alınamaz, o yüzden kapıları betikte duruyor.
!scripts/depo-temizle.mjs
# `kasa` — anahtar kasasının kapısı. 25 Ağu 2026'da CI'da ENOENT verdi:
# tests/unit/kasa.test.ts bu dosyayı okuyor ama `scripts/*` kalıbı onu
# yutmuştu, yani test yalnız benim diskimde geçiyordu. Kasanın VERİSİ
# (kasa.md) yok sayılmaya devam ediyor; depoya giren yalnız araç.
!scripts/kasa.mjs
# Giriş yolu araçları — aynı gerekçe. `telefon:dogrula` mağaza incelemesinin
# en olası ret sebebini (telefonla giriş çalışmıyor) tek komutla sınar;
# `apple:gizli-anahtar` Apple özel anahtarını dışarı çıkarmadan jeton üretir.
!scripts/telefon-girisi-dogrula.mjs
!scripts/apple-gizli-anahtar.mjs
# `giris:dogrula` — Google/Apple girişini üretim paketiyle, gerçek tarayıcıda
# uçtan uca sürer. Kurucunun iki kez bildirdiği "hesabımı seçince uygulama
# yeniden başlıyor" hatasının kilidi bu betikte; depoda olmazsa kilit yok.
!scripts/saglayici-girisi-dogrula.mjs
# `kayit:dogrula` — e-posta+sifre ile KAYIT yolunu ucdan uca surer (kayit →
# 5 adimli kurulum sihirbazi → temiz tarayicida tekrar giris → yanlis sifre).
# Apple'in "Sign-In Information" talebinin karsiligi bu yol; kirilirsa magaza
# incelemesi durur. Sihirbazin uzun-tire/slider gibi tuzaklari da bu betikte
# yazili — depoda olmazsa her seferinde yeniden kesfedilir.
!scripts/kayit-akisi-dogrula.mjs
# `build:legal` bu iki betigi ZINCIR halinde cagirir. build-legal-roles.mjs
# depoda yoksa temiz bir kopyada `npm run build:legal` ENOENT ile durur ve
# rol sozlesmeleri hic uretilemez.
!scripts/build-legal-roles.mjs
# iOS paket onarimi (Podfile.lock yeniden uretimi) — kurucunun Mac'te
# calistirdigi tek komut. Depoda olmazsa `npm run ios:onar` hicbir yerde
# bulunamaz.
!scripts/ios-paket-onar.sh
!scripts/ios-gonderim-onucus.sh
!admin-panel/scripts/admin-panel-verify.mjs
!admin-panel/scripts/admin-supabase-deploy.mjs
!admin-panel/scripts/start-admin-local.mjs
!admin-panel/scripts/supabase-interactive-deploy.sh
