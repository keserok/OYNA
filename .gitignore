# Sondaki eğik çizgi YALNIZ klasörü yok sayar. 2026-08-01'de depoya
# `node_modules` adında bir KISAYOL (symlink) girdi ve bu desen onu tutmadı:
# dalı alan herkeste node_modules kendine dönen bozuk bir bağa dönüştü, tüm
# araçlar kırıldı. Eğik çizgisiz desen ikisini de kapsar.
node_modules
.vite/
dist/
*.zip
*.pdf
.DS_Store
.env
.env.local
.env.*.local
!.env.example
node_modules_old/
node_modules_local/
my_vite.log
tsc_err.log
reports/
scripts/*
!scripts/owner-demo.mjs
!scripts/owner-menu-live-test.mjs
!scripts/regenerate-migrations-from-ledger.mjs
# Mobil paket derlemesi — sync:ios/sync:android bu betiği çağırır. Depoda
# OLMAK ZORUNDA: temiz bir kopyada ya da CI'da yoksa paket hiç üretilemez.
!scripts/build-mobile.mjs
# Kılavuz ekran görüntüsü çekim aracı (tekrar üretilebilirlik için depoda)
!scripts/kilavuz-gorselleri/
!scripts/kilavuz-gorselleri/**
# Mağaza gönderim araçları — depoda OLMAK ZORUNDA. `scripts/*` kalıbı bunları
# sessizce yutuyordu: `npm run magaza:denetim` ve `npm run surum:artir` temiz
# bir kopyada çalışmıyor, gönderim kapısını sınayan testler CI'da ENOENT
# veriyordu. Gönderimin geçtiği kapı, depoda duran bir kapı olmalı.
!scripts/magaza-denetim.mjs
!scripts/surum-artir.mjs
# Giriş yolu araçları — aynı gerekçe. `telefon:dogrula` mağaza incelemesinin
# en olası ret sebebini (telefonla giriş çalışmıyor) tek komutla sınar;
# `apple:gizli-anahtar` Apple özel anahtarını dışarı çıkarmadan jeton üretir.
!scripts/telefon-girisi-dogrula.mjs
!scripts/apple-gizli-anahtar.mjs
# `giris:dogrula` — Google/Apple girişini üretim paketiyle, gerçek tarayıcıda
# uçtan uca sürer. Kurucunun iki kez bildirdiği "hesabımı seçince uygulama
# yeniden başlıyor" hatasının kilidi bu betikte; depoda olmazsa kilit yok.
!scripts/saglayici-girisi-dogrula.mjs
!admin-panel/scripts/admin-panel-verify.mjs
!admin-panel/scripts/admin-supabase-deploy.mjs
!admin-panel/scripts/start-admin-local.mjs
!admin-panel/scripts/supabase-interactive-deploy.sh
