rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Güvenlik Yardımcı Fonksiyonları (Helpers)
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Giriş yapan kullanıcı patron (SUPER_ADMIN veya OWNER) mu?
    function isBoss() {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['SUPER_ADMIN', 'OWNER'] ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', [])).hasAny(['SUPER_ADMIN', 'OWNER'])
      );
    }
    
    // Topluluk yöneticisi (Kendi topluluğundaki işlemlere yetkili)
    function isCommunityAdminFor(communityId) {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isAuthenticated() && 
             (userDoc.get('roles', [])).hasAny(['COMMUNITY_ADMIN']) &&
             (userDoc.get('communities', [])).hasAny([communityId]);
    }

    // ===============================================================
    // Koleksiyon Erişim Kuralları
    // ===============================================================
    
    // USERS (Kullanıcılar)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      // Oyuncu kendi bilgilerini güncellerken yetki, ban, cüzdan ve reyting alanlarını DEĞİŞTİREMEZ.
      // Patron (isBoss) ise her alanı kısıtlamasız güncelleyebilir!
      allow update: if isBoss() || (
        isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'roles', 'wallet', 'isBanned', 'banExpiresAt', 'isShadowBanned', 'isMuted', 'rating', 'playerCard'])
      );
      allow delete: if isBoss();
    }
    
    // COMMUNITIES (Topluluklar)
    match /communities/{communityId} {
      allow read: if true;
      allow write: if isBoss();
    }
    
    // TEAMS (Takımlar)
    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isBoss() || (isAuthenticated() && resource.data.captainId == request.auth.uid);
    }

    // MATCHES (Maçlar)
    match /matches/{matchId} {
      allow read: if true;
      allow create: if isAuthenticated();
      // Oyuncular maça katılmak için slotları güncelleyebilir. Maç durumunu (status) ve kritik alanları sadece patron değiştirebilir.
      allow update: if isBoss() || (
        isAuthenticated() && 
        resource.data.status == 'ACTIVE' && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'price', 'location', 'time', 'date'])
      );
      allow delete: if isBoss();
    }

    // PITCHES (Halı Sahalar)
    match /pitches/{pitchId} {
      allow read: if true;
      allow write: if isBoss(); // Sadece patron ekleyebilir, silebilir veya onaylayabilir
    }

    // REFEREES & GOALKEEPERS (Hakemler & Kaleciler)
    match /referees/{refId} {
      allow read: if true;
      allow write: if isBoss() || isOwner(refId);
    }
    match /goalkeepers/{gkId} {
      allow read: if true;
      allow write: if isBoss() || isOwner(gkId);
    }

    // WALLET / TRANSACTIONS (Cüzdan & Finansal Hareketler)
    match /transactions/{transactionId} {
      allow read: if isBoss() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isBoss(); // Normal şartlarda değiştirilemez, sadece patron override edebilir
    }

    // REVIEWS (Değerlendirmeler)
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
    }

    // DIARIES / MATCH HISTORY (Maç Günlükleri)
    match /diaries/{diaryId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // TACTICS (Taktikler)
    match /tactics/{tacticId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // AUDIT LOGS (Denetim İzi)
    match /audit_logs/{logId} {
      // Sadece patron yazıp okuyabilir (Gizli kalmalı)
      allow read, write: if isBoss();
    }

    // MATCH VERIFICATIONS (Maç Sonucu Onayları)
    match /match_verifications/{verificationId} {
      allow read: if isAuthenticated();
      // Kaptanlar SS yükleyebilir
      allow create: if isAuthenticated() && request.resource.data.submittedBy == request.auth.uid;
      // Sadece patronlar veya maçın ait olduğu topluluğun adminleri onaylayabilir/reddedebilir
      allow update: if isBoss() || isCommunityAdminFor(resource.data.communityId);
      allow delete: if isBoss();
    }
  }
}
