{
  "name": "oyna-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:admin": "node admin-panel/scripts/start-admin-local.mjs",
    "test:unit": "vitest run tests/unit --config vitest.config.ts",
    "test:integration": "bash tests/integration/run.sh",
    "test:e2e:studio": "playwright test --config playwright.hermetic.config.ts",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots",
    "test:admin": "playwright test tests/admin.spec.ts",
    "giris:dogrula": "node scripts/saglayici-girisi-dogrula.mjs",
    "kayit:dogrula": "node scripts/kayit-akisi-dogrula.mjs",
    "kasa:durum": "node scripts/kasa.mjs durum",
    "kasa:kur": "node scripts/kasa.mjs kur",
    "kasa:ac": "node scripts/kasa.mjs ac",
    "kasa:kilitle": "node scripts/kasa.mjs kilitle",
    "magaza:denetim": "node scripts/magaza-denetim.mjs",
    "ios:onar": "bash scripts/ios-paket-onar.sh",
    "ios:gonder": "bash scripts/ios-gonderim-onucus.sh",
    "surum:artir": "node scripts/surum-artir.mjs",
    "admin:verify": "node admin-panel/scripts/admin-panel-verify.mjs",
    "admin:deploy": "node admin-panel/scripts/admin-supabase-deploy.mjs",
    "admin:deploy:interactive": "bash admin-panel/scripts/supabase-interactive-deploy.sh",
    "build": "vite build",
    "build:mobile": "node scripts/build-mobile.mjs",
    "build:legal": "node scripts/build-legal-pages.mjs && node scripts/build-legal-roles.mjs",
    "build:legal:rol": "node scripts/build-legal-roles.mjs",
    "logo:kaynak": "node scripts/logo-kaynak-uret.mjs",
    "assets:generate": "capacitor-assets generate --android --ios",
    "sync:android": "npm run build:mobile && npm run assets:generate && npx cap sync android",
    "sync:ios": "npm run build:mobile && npm run assets:generate && npx cap sync ios",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "owner:demo:seed": "node scripts/owner-demo.mjs seed",
    "owner:demo:purge": "node scripts/owner-demo.mjs purge",
    "owner:menu:live-test": "node scripts/owner-menu-live-test.mjs",
    "godview:demo:seed": "node scripts/godview-demo.mjs seed",
    "godview:demo:purge": "node scripts/godview-demo.mjs purge",
    "etki": "node scripts/sistem/etki.mjs",
    "sistem:harita": "node scripts/sistem/harita.mjs",
    "sistem:kapsam": "node scripts/sistem/kapsam.mjs",
